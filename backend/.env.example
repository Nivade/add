APP_NAME=add
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://add.nvade.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Traefik
APP_SLUG=add
BASE_DOMAIN=nvade.dev
# Separate fake TLD for the debug profile; a single-level wildcard cert covers it.
DEBUG_DOMAIN=nvade.debug
VITE_PORT=5176

WWWUSER=1000
WWWGROUP=1000
COMPOSE_PROJECT_NAME=add
APP_PORT=8029
FORWARD_REDIS_PORT=6382
FORWARD_MAILPIT_PORT=1028
FORWARD_MAILPIT_DASHBOARD_PORT=8028
DEBUG_APP_PORT=8030
FORWARD_BUGSINK_PORT=8031

# These are the values laravel.test and the host run with; laravel.debug
# overrides all three in compose.yaml, so only it records and only it listens.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Bugsink — self-hosted error tracking on the Sentry SDK protocol.
# Generate with `openssl rand -base64 50`; at least 50 characters.
BUGSINK_SECRET_KEY=
BUGSINK_SUPERUSER=admin@example.org:admin
BUGSINK_ALLOWED_HOSTS=*

# Read-only token (issues:read, events:read) from Bugsink's Tokens page, for
# pulling a stacktrace as Markdown rather than pasting one in by hand.
BUGSINK_URL=https://bugsink.nvade.debug
BUGSINK_API_TOKEN=

# Create a project at https://bugsink.nvade.debug, then rewrite the DSN host it shows.
# `.nvade.debug` resolves to 127.0.0.1, which inside a container is that container,
# so the backend must address Bugsink by its Compose service name instead:
# SENTRY_LARAVEL_DSN=http://<key>@bugsink:8000/<project-id>
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=

# AI — canned needs no credentials; openai needs OPENAI_API_KEY.
AI_DRIVER=canned
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=low
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=900
AI_RATE_LIMIT_ATTEMPTS=30
AI_RATE_LIMIT_DECAY=60
AI_REDACT_INPUT=true
OPENAI_API_KEY=
# Calendar — read-only. `ics` reads the feed each person pastes in settings; `none` is no calendar; `fixture` reads storage/calendar-fixtures/{user}.json.
CALENDAR_DRIVER=ics
CALENDAR_HORIZON_DAYS=2

