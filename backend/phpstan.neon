includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/nvade/devtools/config/phpstan.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    stubFiles:
        - stubs/phpstan/vobject.stub

    # Level 8 (devtools default) surfaces ~16 nullable-User/int errors; staying at 7 until that's a separate task.
    level: 7
