{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^0.11.2",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "lorisleiva/laravel-actions": "^2.12",
        "sabre/vobject": "^5.0",
        "sentry/sentry-laravel": "^4.28",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laravel/telescope": "^5.25",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "nvade/devtools": "^0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=3G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@refactor:check",
            "@php -d memory_limit=1G artisan test --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "setup:db": [
            "@php artisan migrate --force"
        ],
        "lint:dirty": [
            "pint --dirty"
        ],
        "refactor": [
            "rector process"
        ],
        "refactor:check": [
            "rector process --dry-run"
        ],
        "test:impact": [
            "@php -d memory_limit=1G vendor/bin/pest --tia --filtered"
        ],
        "test:serial": [
            "@php -d memory_limit=1G artisan test"
        ],
        "test:coverage": [
            "@php -d memory_limit=1G vendor/bin/pest --parallel --coverage"
        ],
        "test:browser": [
            "@php vendor/bin/pest tests/Browser"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        },
        "devtools": {
            "components": [
                "branches",
                "ci",
                "commits",
                "compose",
                "editorconfig",
                "gitattributes",
                "npm",
                "npmrc",
                "phpstan",
                "phpunit",
                "pint",
                "rector",
                "scripts",
                "vite"
            ],
            "ci-host": "github"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "devtools": {
            "type": "vcs",
            "url": "git@gitlab.com:nvade-packages/devtools.git"
        }
    }
}
