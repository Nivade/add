# Local check only: --no-verify skips it. .github/workflows/branch-name.yml or
# .gitlab/ci/branch-name.yml is the gate that actually stops a bad branch name.
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    case $remote_ref in
        refs/heads/*) : ;;
        *) continue ;;
    esac

    branch=${remote_ref#refs/heads/}

    if ! sh "$(dirname "$0")/check-branch-name" "$branch"; then
        echo "Fix it with: git branch -m <new-name>" >&2
        exit 1
    fi
done
