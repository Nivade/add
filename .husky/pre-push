# Local check only: --no-verify skips it. .github/workflows/branch-name.yml or
# .gitlab/ci/branch-name.yml is the gate that actually stops a bad branch name.
# A missing ref is all zeros: 40 in a SHA-1 repo, 64 in a SHA-256 one.
is_zero() {
    case $1 in
        *[!0]*) return 1 ;;
    esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
    is_zero "$local_sha" && continue

    case $remote_ref in
        refs/heads/*) : ;;
        *) continue ;;
    esac

    branch=${remote_ref#refs/heads/}

    # A branch that already exists on the remote gets CI's rules, so bot branches pass.
    ci_flag="--ci"
    is_zero "$remote_sha" && ci_flag=""

    if ! sh "$(dirname "$0")/check-branch-name" "$branch" $ci_flag; then
        echo "Fix it with: git branch -m <new-name>" >&2
        exit 1
    fi
done
