# Copy to mobile/.env. Unset means the deployed backend.
# Sail's direct HTTP port, since Traefik's hostname and cert mean nothing to a device.
# Android emulator reaching the host:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8029
# A physical device on the same Wi-Fi wants the host's LAN address instead:
# EXPO_PUBLIC_API_URL=http://192.168.2.86:8029
