.ai/skills/*/scripts/.cache/

# Points at the root .ai so Boost, whose base path is backend/, writes through it.
backend/.ai

# Hash of the generated TypeScript, rewritten by every `types:generate`.
packages/shared/src/typescript-transformer-manifest.json
